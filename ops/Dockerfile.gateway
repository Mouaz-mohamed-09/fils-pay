# Builds the merchant dashboard/checkout (apps/web) and the admin console
# (apps/admin) as static files and serves them from Caddy, which also
# terminates TLS and proxies /v1 to the API (same-origin, so no CORS).
FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/api/package.json apps/api/package.json
COPY apps/reporting/package.json apps/reporting/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
RUN npm ci --no-audit --no-fund
COPY apps/web ./apps/web
COPY apps/admin ./apps/admin
# Empty base URL = call /v1 on the same origin the page came from.
ENV VITE_API_BASE_URL="" VITE_ADMIN_API_BASE_URL=""
ARG WEB_BASE_URL=https://localhost
ENV VITE_WEB_BASE_URL=${WEB_BASE_URL}
RUN npm run build --workspace apps/web && npm run build --workspace apps/admin

FROM caddy:2-alpine
COPY ops/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/web
COPY --from=build /app/apps/admin/dist /srv/admin
