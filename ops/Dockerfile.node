# Image for apps/api, apps/reporting and the migrate/seed jobs (see
# docker-compose.yml). Services run TypeScript through tsx, a devDependency,
# so this is a full workspace install.
# Full image, not -slim: argon2 builds natively on arm64 and needs python3/make/g++.
# Node 22: the workspaces' test scripts pass globs to `node --test`, which Node 20 does not expand.
FROM node:22-bookworm
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/api/package.json apps/api/package.json
COPY apps/reporting/package.json apps/reporting/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
RUN npm ci --no-audit --no-fund

COPY . .
# NODE_ENV comes from ops/.env.docker on the hosted box, not the image.
EXPOSE 3000
CMD ["npx", "tsx", "apps/api/src/index.ts"]
