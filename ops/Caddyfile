# SITE_DOMAIN serves checkout + merchant dashboard; ADMIN_DOMAIN the admin
# console. Real domains get Let's Encrypt certificates automatically;
# "localhost" gets Caddy's local CA, so the stack runs the same on a laptop.
# No ACME account email is required; add a global `email` block if you want
# Let's Encrypt expiry notices.

(common) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle /v1/* {
		reverse_proxy api:3000 {
			# Fail fast when the API is down or restarting instead of hanging clients.
			lb_try_duration 2s
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}
	handle /healthz {
		reverse_proxy api:3000
	}
}

{$SITE_DOMAIN:localhost} {
	import common
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_DOMAIN:admin.localhost} {
	import common
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
