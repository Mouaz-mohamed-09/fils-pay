# Copy to ops/.env.prod (git-ignored) and fill in every value.
# Generate secrets with:  openssl rand -base64 32
NODE_ENV=production
LOG_LEVEL=warn

SITE_DOMAIN=pay.example.com
ADMIN_DOMAIN=admin.pay.example.com
CHECKOUT_BASE_URL=https://pay.example.com

POSTGRES_PASSWORD=
DATABASE_URL=postgres://filspay:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/filspay?sslmode=disable

# 32 random bytes, base64 (openssl rand -base64 32)
WEBHOOK_SECRET_ENCRYPTION_KEY=
ACQUIRER_CALLBACK_SIGNING_SECRET=
SETTLEMENT_INTERNAL_TOKEN=

# API capacity knobs (see docs/CAPACITY.md)
PG_POOL_MAX=10
MAX_INFLIGHT_REQUESTS=64
COOKIE_SECURE=true
